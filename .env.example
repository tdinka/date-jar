# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string from Railway (Postgres service -> Variables -> DATABASE_PUBLIC_URL for local use)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# Long random string used to sign login cookies. Make one with: openssl rand -base64 32
SESSION_SECRET=""

# The only email addresses allowed to sign in, separated by commas
ALLOWED_EMAILS="you@example.com,partner@example.com"

# Resend (resend.com) key for sending login codes. Leave empty while testing locally:
# the code is then printed in the terminal instead of emailed.
RESEND_API_KEY=""
# Sender address. "onboarding@resend.dev" works for testing (only to your own Resend account email).
EMAIL_FROM="Date Jar <onboarding@resend.dev>"  # live app uses Date Jar <dates@tsegadinka.com> (verified in Resend)
